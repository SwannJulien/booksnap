meta {
  name: logout
  type: http
  seq: 3
}

post {
  url: {{vipa}}/api/v1/auth/logout
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Answers 204, invalidates the session server-side and clears the JSESSIONID cookie.

  Handled by Spring Security's LogoutFilter, not by AuthController: the filter catches
  the URL before the dispatcher, so there is no controller method behind this one.
}
